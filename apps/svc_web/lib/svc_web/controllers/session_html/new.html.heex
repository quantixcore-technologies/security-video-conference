<div class="min-h-screen flex items-center justify-center px-4">
  <div class="w-full max-w-sm">
    <div class="flex flex-col items-center mb-8">
      <div class="grid place-items-center size-14 rounded-2xl bg-primary/15 text-primary ring-1 ring-primary/20 mb-4">
        <.icon name="hero-shield-check" class="size-7" />
      </div>
      <h1 class="text-xl font-semibold tracking-tight text-center">Security Video Conference</h1>
      <p class="text-sm text-base-content/50 mt-1">{gettext("Защищённый вход в систему")}</p>
    </div>

    <div class="rounded-2xl border border-base-300 bg-base-100/60 p-6">
      <div
        :if={@error_message}
        class="mb-4 flex items-center gap-2 rounded-lg bg-error/10 border border-error/20 px-3 py-2.5 text-sm text-error"
      >
        <.icon name="hero-exclamation-triangle" class="size-4 shrink-0" />
        {@error_message}
      </div>

      <.form for={to_form(%{}, as: :user)} action={~p"/login"} class="space-y-4">
        <label class="block">
          <span class="text-xs font-medium text-base-content/60 mb-1.5 block">
            {gettext("Логин")}
          </span>
          <input
            type="text"
            name="user[username]"
            required
            autocomplete="username"
            placeholder="username"
            class="input input-bordered w-full bg-base-200/40 tabular"
          />
        </label>
        <label class="block">
          <span class="text-xs font-medium text-base-content/60 mb-1.5 block">
            {gettext("Пароль")}
          </span>
          <div class="relative">
            <input
              id="login-password"
              type="password"
              name="user[password]"
              required
              autocomplete="current-password"
              placeholder="••••••••••••"
              class="input input-bordered w-full bg-base-200/40 pr-11"
            />
            <button
              type="button"
              data-password-toggle
              aria-pressed="false"
              aria-label={gettext("Показать пароль")}
              title={gettext("Показать пароль")}
              class="absolute inset-y-0 right-0 flex items-center px-3 text-base-content/45 hover:text-base-content transition"
            >
              <span data-eye-show><.icon name="hero-eye" class="size-5" /></span>
              <span data-eye-hide class="hidden">
                <.icon name="hero-eye-slash" class="size-5" />
              </span>
            </button>
          </div>
        </label>
        <button type="submit" class="btn btn-primary w-full gap-2">
          <.icon name="hero-arrow-right-end-on-rectangle" class="size-4" /> {gettext("Войти")}
        </button>
      </.form>
    </div>

    <p class="text-center text-xs text-base-content/35 mt-6 flex items-center justify-center gap-1.5">
      <.icon name="hero-lock-closed" class="size-3" /> {gettext("Соединение защищено · B2G")}
    </p>
  </div>
</div>

<script>
  // Кнопка-глаз: показать/скрыть пароль при вводе. Без неё на телефоне
  // пароль набирается вслепую, и это главная причина ошибок входа.
  (function () {
    var btn = document.querySelector("[data-password-toggle]");
    var input = document.getElementById("login-password");
    if (!btn || !input) return;

    btn.addEventListener("click", function () {
      var shown = input.type === "text";
      input.type = shown ? "password" : "text";
      btn.setAttribute("aria-pressed", String(!shown));
      btn.querySelector("[data-eye-show]").classList.toggle("hidden", !shown);
      btn.querySelector("[data-eye-hide]").classList.toggle("hidden", shown);
      input.focus();
    });
  })();
</script>
