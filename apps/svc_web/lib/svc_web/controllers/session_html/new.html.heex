<div class="min-h-screen flex items-center justify-center px-4">
  <div class="w-full max-w-sm">
    <div class="flex flex-col items-center mb-8">
      <div class="grid place-items-center size-14 rounded-2xl bg-primary/15 text-primary ring-1 ring-primary/20 mb-4">
        <.icon name="hero-shield-check" class="size-7" />
      </div>
      <h1 class="text-xl font-semibold tracking-tight text-center">Security Video Conference</h1>
      <p class="text-sm text-base-content/50 mt-1">{gettext("Защищённый вход в систему")}</p>
    </div>

    <div class="rounded-2xl border border-base-300 bg-base-100/60 p-6">
      <div
        :if={@error_message}
        class="mb-4 flex items-center gap-2 rounded-lg bg-error/10 border border-error/20 px-3 py-2.5 text-sm text-error"
      >
        <.icon name="hero-exclamation-triangle" class="size-4 shrink-0" />
        {@error_message}
      </div>

      <.form for={to_form(%{}, as: :user)} action={~p"/login"} class="space-y-4">
        <label class="block">
          <span class="text-xs font-medium text-base-content/60 mb-1.5 block">{gettext("Логин")}</span>
          <input
            type="text"
            name="user[username]"
            required
            autocomplete="username"
            placeholder="username"
            class="input input-bordered w-full bg-base-200/40 tabular"
          />
        </label>
        <label class="block">
          <span class="text-xs font-medium text-base-content/60 mb-1.5 block">{gettext("Пароль")}</span>
          <input
            type="password"
            name="user[password]"
            required
            autocomplete="current-password"
            placeholder="••••••••••••"
            class="input input-bordered w-full bg-base-200/40"
          />
        </label>
        <button type="submit" class="btn btn-primary w-full gap-2">
          <.icon name="hero-arrow-right-end-on-rectangle" class="size-4" /> {gettext("Войти")}
        </button>
      </.form>
    </div>

    <p class="text-center text-xs text-base-content/35 mt-6 flex items-center justify-center gap-1.5">
      <.icon name="hero-lock-closed" class="size-3" /> {gettext("Соединение защищено · B2G")}
    </p>
  </div>
</div>
