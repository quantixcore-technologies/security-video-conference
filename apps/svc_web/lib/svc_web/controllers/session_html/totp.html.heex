<div class="mx-auto max-w-sm px-4 mt-20">
  <h1 class="text-2xl font-bold text-center">Двухфакторная аутентификация</h1>
  <p class="text-center text-gray-500 mb-6">Введите 6-значный код из приложения-аутентификатора</p>

  <div :if={@error_message} class="mb-4 rounded bg-red-100 p-3 text-sm text-red-700">
    {@error_message}
  </div>

  <.form for={to_form(%{}, as: :totp)} action={~p"/login/totp"} class="space-y-4">
    <div>
      <label class="block text-sm font-medium mb-1">Код 2FA</label>
      <input
        type="text"
        name="totp[code]"
        inputmode="numeric"
        pattern="[0-9]*"
        maxlength="6"
        required
        autofocus
        autocomplete="one-time-code"
        class="w-full rounded border px-3 py-2 text-center text-lg tracking-widest"
      />
    </div>
    <button
      type="submit"
      class="w-full rounded bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-700"
    >
      Подтвердить
    </button>
  </.form>
</div>
